{
  "expo": {
    "name": "useless",
    "slug": "lessismore-app",
    "version": "1.1.9",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lessismoreapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.doublejbs.useless",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "WKCompanionAppBundleIdentifier": "",
        "WatchKitApp": false
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "usesAppleSignIn": true,
      "appleTeamId": "NFV6WC2X83"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "package": "com.doublejbs.useless",
      "permissions": ["android.permission.RECORD_AUDIO"],
      "userInterfaceStyle": "light"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#151515"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "이 앱은 장비 사진을 선택하기 위해 사진 라이브러리에 접근합니다.",
          "cameraPermission": "이 앱은 장비 사진을 촬영하기 위해 카메라에 접근합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "이 앱은 공유 이미지를 저장하기 위해 사진 라이브러리에 접근합니다.",
          "savePhotosPermission": "이 앱은 공유 이미지를 저장하기 위해 사진 라이브러리에 접근합니다."
        }
      ],
      [
        "@hot-updater/react-native",
        {
          "channel": "production"
        }
      ],
      "expo-font",
      "./plugins/WithMlKitVisionDependencies.js",
      "./plugins/WithFirebaseMessagingNotificationColor.js",
      "@react-native-firebase/messaging",
      [
        "expo-notifications",
        {
          "color": "#151515"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24aefc8a-2fb8-40f2-9d1b-5361537863a5"
      }
    }
  }
}
