rules_version = '2';

// 그룹 코스(GPX) 원본 Storage 보안 규칙 (DM-9, DM-29, GRP-8).
//
// 경로: groups/{groupId}/routes/{routeId}.gpx
//
// 커뮤니티 사진(/community/**)은 읽기가 공개지만 그룹 코스는 **그룹원만** 읽는다.
// Storage 규칙에서 Firestore 를 교차 조회할 수 있으므로 멤버십 판정 소스를
// Firestore 와 똑같이 `groups/{groupId}.memberIds` 하나로 유지한다(DM-29).
//
// 이 파일은 그룹 경로 전용이다. 배포는 docs/firebase/deployed/storage.rules 병합본으로만
// 하며, 병합 시 기존 `/{allPaths=**}` 개방 절에서 `groups/` 접두를 제외해야 한다
// (docs/firebase/README.md "그룹 규칙 병합 시 주의" 참고).

service firebase.storage {
  match /b/{bucket}/o {

    match /groups/{groupId}/routes/{fileName} {
      function isGroupMember() {
        return request.auth != null
          && request.auth.uid in
            firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
      }

      function isGpxFile() {
        return fileName.matches('^[A-Za-z0-9_-]+\\.gpx$');
      }

      // `read` 는 get 과 list 를 함께 여는 이름이므로 쓰지 않는다. 단건 다운로드만 연다.
      allow get: if isGroupMember() && isGpxFile();

      // 5MB 상한(GRP-8). 삭제 요청에는 request.resource 가 없으므로 별도 규칙으로 나눈다.
      allow create, update: if isGroupMember()
        && isGpxFile()
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;

      // 코스를 지우면 Firestore 문서와 Storage 파일을 함께 지운다(GRP-8).
      // 올린 사람인지 방장인지는 Firestore 규칙이 판정하고, 여기서는 그룹원인지만 본다 —
      // Storage 규칙에서 routes 문서의 authorId 를 읽으려면 교차 조회가 한 번 더 필요하고,
      // 파일만 지우고 문서를 남기는 요청은 그룹 안에서 복구 가능한 손상이기 때문이다.
      allow delete: if isGroupMember() && isGpxFile();
    }

    // 경로 목록 조회는 어떤 경우에도 허용하지 않는다 — 그룹의 코스 목록은
    // Firestore `groups/{groupId}/routes` 로만 읽는다.
    match /groups/{allPaths=**} {
      allow list: if false;
    }
  }
}
