rules_version = '2';

// 그룹(DM-29, GRP-1~12) Firestore 보안 규칙.
//
// 그룹은 앱에서 처음으로 **특정 사용자 집합에게만 보이는 데이터**를 도입한다.
// 기존 가시성은 공개(커뮤니티·박지 카탈로그), 본인만(users/*), 링크를 아는 사람 전부(bag.shared)
// 세 가지뿐이었다(DataModel.md DM-29).
//
// 멤버십 판정은 `groups/{groupId}.memberIds` 배열 **하나**로 한다. 하위 컬렉션은 모두
// 이 배열을 get() 한 번으로 읽어 판정하므로 규칙 비용이 예측 가능하다(배열 상한 20).
//
// 이 파일은 **그룹 컬렉션 전용**이다. 배포는 docs/firebase/deployed/firestore.rules 병합본으로만
// 하며, 병합 시 맨 끝의 전면 개방 절에서 `groups`와 `users/{uid}/groups`를 제외해야 한다
// (docs/firebase/README.md "그룹 규칙 병합 시 주의" 참고).

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 공통 헬퍼 -------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // GRP-2 / GRP-3 / GRP-8 / GRP-9 의 상한을 한곳에서 관리한다.
    function maxGroupMembers() {
      return 20;
    }

    function maxGroupPoints() {
      return 50;
    }

    function maxGroupRoutes() {
      return 5;
    }

    function maxRouteFileSize() {
      return 5 * 1024 * 1024;
    }

    // --- 그룹 문서 접근 헬퍼 ----------------------------------------------

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    // 커밋 **전** 상태. 읽기·수정·삭제 판정에 쓴다.
    function groupBefore(groupId) {
      return get(groupPath(groupId)).data;
    }

    // 커밋 **후** 상태. 그룹 생성 배치(그룹 문서 + 방장 멤버 문서)나 참여 배치처럼
    // 같은 커밋에서 memberIds가 바뀌는 경우에 쓴다. get()은 커밋 전 상태만 보므로
    // 생성 시점에는 그룹 문서가 아직 없어 판정이 불가능하다.
    function groupAfter(groupId) {
      return getAfter(groupPath(groupId)).data;
    }

    function isGroupMember(groupId) {
      return signedIn() && request.auth.uid in groupBefore(groupId).memberIds;
    }

    function willBeGroupMember(groupId) {
      return signedIn() && request.auth.uid in groupAfter(groupId).memberIds;
    }

    function isGroupOwner(groupId) {
      return signedIn() && groupBefore(groupId).ownerId == request.auth.uid;
    }

    // --- 값 검증 헬퍼 -----------------------------------------------------

    function isIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // `YYYY-MM-DD` 는 사전순 비교가 곧 날짜순 비교다(고정 폭 + 0 패딩).
    // 규칙 언어에는 날짜 산술이 없어 GRP-2 의 "최대 30일"은 강제하지 못한다(클라이언트 검증).
    function isValidPeriod(startDate, endDate) {
      return isIsoDate(startDate) && isIsoDate(endDate) && startDate <= endDate;
    }

    // trim 은 규칙에서 할 수 없다. 길이 상한만 막고 공백 정규화는 클라이언트 몫이다(GRP-2).
    function isValidGroupName(value) {
      return value is string && value.size() >= 2 && value.size() <= 40;
    }

    function isValidLatitude(value) {
      return value is number && value >= -90 && value <= 90;
    }

    function isValidLongitude(value) {
      return value is number && value >= -180 && value <= 180;
    }

    function unchangedField(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function changedByOne(field) {
      return request.resource.data[field] == resource.data[field] + 1
        || request.resource.data[field] == resource.data[field] - 1;
    }

    // --- groups/{groupId} -------------------------------------------------

    // 서버 전용 필드 `deletedCleanedAt`(해산 연쇄 정리 멱등 가드)은 아래 어떤
    // 허용 키 목록에도 들어 있지 않다. 따라서 클라이언트는 생성·수정 어느 경로로도 쓸 수 없다.
    function groupWritableKeys() {
      return [
        'name', 'startDate', 'endDate', 'ownerId', 'memberIds', 'memberCount',
        'campSpotId', 'destinationName', 'meetingNote', 'inviteEnabled',
        'pointCount', 'routeCount', 'createdAt', 'updatedAt'
      ];
    }

    function isValidGroupPayload() {
      let data = request.resource.data;

      return isValidGroupName(data.name)
        && isValidPeriod(data.startDate, data.endDate)
        && data.inviteEnabled is bool
        && (!('campSpotId' in data)
          || (data.campSpotId is string && data.campSpotId.size() > 0))
        && (!('destinationName' in data)
          || (data.destinationName is string && data.destinationName.size() <= 100))
        && (!('meetingNote' in data)
          || (data.meetingNote is string && data.meetingNote.size() <= 200));
    }

    // 방장 편집(GRP-4). ownerId·memberIds·memberCount·pointCount·routeCount 는
    // 허용 키 목록에 없으므로 이 경로로는 바뀌지 않는다.
    function isGroupOwnerEdit() {
      return resource.data.ownerId == request.auth.uid
        && changedKeys().hasOnly([
          'name', 'startDate', 'endDate', 'campSpotId', 'destinationName',
          'meetingNote', 'inviteEnabled', 'updatedAt'
        ])
        && isValidGroupPayload();
    }

    // 참여(GRP-3). memberIds 에 **자기 uid 하나만** 늘어난 update 로 처리한다.
    //
    // 규칙 언어에는 배열 diff 연산이 없어 `size() + hasAll + in` 조합으로 좁힌다.
    //   - after.size() == before.size() + 1  → 정확히 하나 늘었다
    //   - after.hasAll(before)               → 기존 원소가 하나도 빠지지 않았다
    //   - uid in after && !(uid in before)   → 늘어난 그 하나가 요청자 자신이다
    // 이 조합은 memberIds 에 중복 원소가 없다는 전제에서 완전하다. 중복은 생성 규칙
    // (`memberIds == [uid]`)과 참여·탈퇴 규칙이 귀납적으로 막는다(참여는 이미 있는 uid 를
    // 다시 넣지 못하고, 탈퇴는 원소를 뺄 뿐이다).
    function isGroupJoin() {
      let before = resource.data.memberIds;
      let after = request.resource.data.memberIds;

      return resource.data.inviteEnabled == true
        && changedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt'])
        && after.size() == before.size() + 1
        && after.size() <= maxGroupMembers()
        && after.hasAll(before)
        && !(request.auth.uid in before)
        && request.auth.uid in after
        && request.resource.data.memberCount == after.size();
    }

    // 탈퇴(본인) · 내보내기(방장) (GRP-4, GRP-12).
    //   - before.hasAll(after) + size-1 → 정확히 하나 빠졌다
    //   - 방장은 배열에서 빠질 수 없다 → 방장이 나가려면 해산(delete)을 거쳐야 한다
    //   - 본인 탈퇴: 빠진 그 하나가 요청자다
    //   - 내보내기: 요청자가 방장이고 스스로는 남아 있다(빠진 대상은 방장이 아닌 멤버 하나)
    function isGroupLeaveOrKick() {
      let before = resource.data.memberIds;
      let after = request.resource.data.memberIds;

      return changedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt'])
        && after.size() == before.size() - 1
        && before.hasAll(after)
        && request.resource.data.memberCount == after.size()
        && resource.data.ownerId in after
        && (
          (request.auth.uid in before && !(request.auth.uid in after))
          || (resource.data.ownerId == request.auth.uid && request.auth.uid in after)
        );
    }

    // 하위 문서 카운터(GRP-8, GRP-9). 포인트·코스 생성/삭제 배치가 같은 커밋에서
    // 이 경로로 카운터를 ±1 한다. 임의값 세팅은 불가능하고, 상한을 여기서 막는다.
    //
    // 남는 구멍: 포인트를 만들지 않고 카운터만 올려 그룹의 포인트 예산을 소진하는
    // 멤버 griefing 은 막지 못한다. 포인트·코스 문서 ID가 랜덤이라 커뮤니티 좋아요처럼
    // 결정적 ID로 `existsAfter()` 대조를 할 수 없기 때문이다. 그룹은 초대로만 들어오는
    // 20인 이하 집단이고 피해가 그 그룹 안에 갇히므로 수용한다(2026-09-17 결정).
    function isGroupCounterUpdate() {
      return request.auth.uid in resource.data.memberIds
        && changedKeys().hasOnly(['pointCount', 'routeCount', 'updatedAt'])
        && (
          (changedByOne('pointCount') && unchangedField('routeCount'))
          || (changedByOne('routeCount') && unchangedField('pointCount'))
        )
        && request.resource.data.pointCount >= 0
        && request.resource.data.pointCount <= maxGroupPoints()
        && request.resource.data.routeCount >= 0
        && request.resource.data.routeCount <= maxGroupRoutes();
    }

    match /groups/{groupId} {
      // `groupId` 자체가 초대 비밀이다(GRP-3). Firestore 자동 생성 20자 ID는 추측할 수
      // 없고, 배낭 링크 공유와 같은 보안 수준이다. 초대 화면에서 비멤버가 이름·기간·정원·
      // inviteEnabled 를 봐야 하므로 인증 사용자면 단건 읽기를 허용한다.
      allow get: if signedIn();

      // 목록 조회는 금지한다. 전체 그룹 열거를 막고, 내 그룹 목록은
      // users/{uid}/groups 역인덱스로만 읽는다(DM-29).
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(groupWritableKeys())
        && request.resource.data.keys().hasAll([
          'name', 'startDate', 'endDate', 'ownerId', 'memberIds', 'memberCount',
          'inviteEnabled', 'pointCount', 'routeCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberCount == 1
        && request.resource.data.pointCount == 0
        && request.resource.data.routeCount == 0
        && isValidGroupPayload();

      // 네 경로만 허용한다: 방장 편집 · 참여 · 탈퇴/내보내기 · 하위 문서 카운터.
      // 어느 경로도 ownerId 를 바꾸지 않는다(방장 위임 없음, GRP-4).
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(groupWritableKeys())
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          isGroupOwnerEdit()
          || isGroupJoin()
          || isGroupLeaveOrKick()
          || isGroupCounterUpdate()
        );

      // 해산은 방장만(GRP-4). 하위 컬렉션·Storage GPX 연쇄 정리는 재시도 가능한
      // 서버 작업이 맡는다(GRP-12, DM-29 서버 작업).
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // --- groups/{groupId}/members/{memberId} ---------------------------

      match /members/{memberId} {
        allow read: if isGroupMember(groupId);

        // 그룹 생성 배치(그룹 문서 + 방장 멤버 문서)와 참여 배치 모두 같은 커밋에서
        // memberIds 가 정해지므로 커밋 **후** 상태로 판정한다.
        allow create: if isOwner(memberId)
          && willBeGroupMember(groupId)
          && request.resource.data.keys().hasOnly([
            'uid', 'nickname', 'role', 'bagId', 'joinedAt'
          ])
          && request.resource.data.keys().hasAll(['uid', 'nickname', 'role', 'joinedAt'])
          && request.resource.data.uid == memberId
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 40
          // role 은 그룹 문서의 ownerId 와 반드시 일치한다. 방장이 아닌 사람이
          // owner 로 들어오거나, 방장이 member 로 들어오는 것을 막는다.
          && request.resource.data.role ==
            (groupAfter(groupId).ownerId == memberId ? 'owner' : 'member')
          && (!('bagId' in request.resource.data)
            || (request.resource.data.bagId is string
              && request.resource.data.bagId.size() > 0));

        // 본인 문서만 수정한다(배낭 연결·해제, 닉네임 갱신). `role` 은 생성 시에만
        // 정해지고 이후 불변이다 — 허용 키 목록에 없다(방장 위임 없음, GRP-4).
        allow update: if isOwner(memberId)
          && isGroupMember(groupId)
          && changedKeys().hasOnly(['nickname', 'bagId'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 40
          && (!('bagId' in request.resource.data)
            || (request.resource.data.bagId is string
              && request.resource.data.bagId.size() > 0));

        // 본인 탈퇴 또는 방장의 내보내기(GRP-4, GRP-12).
        // 탈퇴 배치는 groups.memberIds 도 같이 바꾸므로 커밋 전 상태로 판정한다.
        allow delete: if isOwner(memberId) || isGroupOwner(groupId);
      }

      // --- groups/{groupId}/bags/{memberId} ------------------------------
      //
      // 멤버 배낭 공개 스냅샷(GRP-5, DM-29 = DM-28 bagSnapshot 과 같은 계약).
      //
      // **이 허용 키 목록이 개인정보 계약의 마지막 방어선이다.** `bag` 문서에는 메모·
      // 좌표·건강 기록이 함께 들어 있어 그룹원에게 읽기를 열면 그것까지 열린다. 스냅샷을
      // 그룹 하위에 따로 두고 규칙으로 키를 못박아 공개 범위를 **데이터 모양으로 고정**한다.
      //
      // 담지 않는 것: 메모, 정확한 좌표, 이동 경로, 건강·활동 기록(DM-22),
      // 개인 장비 imageUrl, 사용자 정의 장비 문서 ID.

      match /bags/{memberId} {
        function isValidBagSnapshot() {
          let data = request.resource.data;

          return data.keys().hasOnly([
              'bagId', 'name', 'startDate', 'endDate', 'destinationName',
              'totalWeight', 'itemCount', 'gears', 'syncedAt'
            ])
            && data.keys().hasAll([
              'bagId', 'name', 'totalWeight', 'itemCount', 'gears', 'syncedAt'
            ])
            && data.bagId is string && data.bagId.size() > 0
            && data.name is string && data.name.size() <= 100
            && (!('startDate' in data) || isIsoDate(data.startDate))
            && (!('endDate' in data) || isIsoDate(data.endDate))
            && (!('destinationName' in data)
              || (data.destinationName is string && data.destinationName.size() <= 100))
            && data.totalWeight is number && data.totalWeight >= 0
            && data.itemCount is int && data.itemCount >= 0
            && data.gears is list && data.gears.size() <= 300
            && data.syncedAt is timestamp;
        }

        allow read: if isGroupMember(groupId);

        // 문서 ID == 자기 uid. 멤버당 하나로 구조적으로 고정된다.
        allow create, update: if isOwner(memberId)
          && isGroupMember(groupId)
          && isValidBagSnapshot();

        // 연결 해제(본인) 또는 내보내기·해산 정리(방장).
        allow delete: if isOwner(memberId) || isGroupOwner(groupId);
      }

      // --- groups/{groupId}/points/{pointId} -----------------------------

      match /points/{pointId} {
        function isValidPointPayload() {
          let data = request.resource.data;

          return data.type in ['water', 'shelter', 'caution', 'note']
            && isValidLatitude(data.latitude)
            && isValidLongitude(data.longitude)
            && data.title is string
            && data.title.size() >= 1
            && data.title.size() <= 40
            && (!('description' in data)
              || (data.description is string && data.description.size() <= 200));
        }

        // 그룹당 50개 상한(GRP-9)은 컬렉션 문서 수를 셀 수 없어 규칙만으로는 막지 못한다.
        // 대신 생성·삭제를 groups.pointCount ±1 과 **같은 커밋**으로 묶어 상한을 강제한다.
        // 클라이언트 계약: createPoint/deletePoint 는 writeBatch 로 문서와 카운터를 함께 쓴다.
        function pointCounterIncremented() {
          return groupAfter(groupId).pointCount == groupBefore(groupId).pointCount + 1;
        }

        function pointCounterDecremented() {
          return groupAfter(groupId).pointCount == groupBefore(groupId).pointCount - 1;
        }

        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.keys().hasOnly([
            'type', 'latitude', 'longitude', 'title', 'description',
            'authorId', 'authorName', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'type', 'latitude', 'longitude', 'title', 'authorId', 'authorName', 'createdAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 40
          && isValidPointPayload()
          && pointCounterIncremented();

        // 올린 사람과 방장만 수정한다(GRP-4, GRP-9). authorId·authorName 은 불변이다 —
        // 나간 멤버 표시(`(나간 멤버)`) 치환은 서버 작업이 맡는다(GRP-12).
        allow update: if isGroupMember(groupId)
          && (resource.data.authorId == request.auth.uid || isGroupOwner(groupId))
          && changedKeys().hasOnly([
            'type', 'latitude', 'longitude', 'title', 'description', 'updatedAt'
          ])
          && request.resource.data.authorId == resource.data.authorId
          && isValidPointPayload();

        allow delete: if isGroupMember(groupId)
          && (resource.data.authorId == request.auth.uid || isGroupOwner(groupId))
          && pointCounterDecremented();
      }

      // --- groups/{groupId}/routes/{routeId} -----------------------------

      match /routes/{routeId} {
        function isValidRoutePayload() {
          let data = request.resource.data;

          return data.name is string
            && data.name.size() >= 1
            && data.name.size() <= 40
            // 원본 GPX 는 Storage 에만 둔다. 경로를 문서 ID에 못박아 남의 파일을 가리키지 못하게 한다.
            && data.storagePath == 'groups/' + groupId + '/routes/' + routeId + '.gpx'
            && data.fileSize is int
            && data.fileSize > 0
            && data.fileSize <= maxRouteFileSize()
            && data.distance is number
            && data.distance >= 0
            && (!('elevationGain' in data)
              || (data.elevationGain is number && data.elevationGain >= 0))
            && data.pointCount is int
            && data.pointCount >= 0
            && data.bounds is map
            && data.bounds.keys().hasOnly(['minLat', 'maxLat', 'minLng', 'maxLng'])
            && data.bounds.keys().hasAll(['minLat', 'maxLat', 'minLng', 'maxLng'])
            && isValidLatitude(data.bounds.minLat)
            && isValidLatitude(data.bounds.maxLat)
            && isValidLongitude(data.bounds.minLng)
            && isValidLongitude(data.bounds.maxLng)
            // 축약 좌표 500점 상한(GRP-8). 원본 트랙포인트 전체는 Firestore 에 넣지 않는다 —
            // 1MB 문서 한도와 렌더 성능 때문이다.
            && data.simplified is list
            && data.simplified.size() >= 2
            && data.simplified.size() <= 500;
        }

        // 그룹당 5개 상한(GRP-8). 포인트와 같은 배치 결합으로 강제한다.
        function routeCounterIncremented() {
          return groupAfter(groupId).routeCount == groupBefore(groupId).routeCount + 1;
        }

        function routeCounterDecremented() {
          return groupAfter(groupId).routeCount == groupBefore(groupId).routeCount - 1;
        }

        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.keys().hasOnly([
            'name', 'storagePath', 'fileSize', 'distance', 'elevationGain',
            'pointCount', 'bounds', 'simplified', 'authorId', 'authorName', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'name', 'storagePath', 'fileSize', 'distance', 'pointCount',
            'bounds', 'simplified', 'authorId', 'authorName', 'createdAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 40
          && isValidRoutePayload()
          && routeCounterIncremented();

        // 코스는 이름 변경이 필요 없으므로 수정 경로를 두지 않는다(GRP-8).
        allow update: if false;

        allow delete: if isGroupMember(groupId)
          && (resource.data.authorId == request.auth.uid || isGroupOwner(groupId))
          && routeCounterDecremented();
      }
    }

    // --- users/{userId}/groups/{groupId} 역인덱스 --------------------------
    //
    // 내가 속한 그룹 목록(DM-29). 이 경로는 현재 배포본의 전면 개방 절에 걸려 있으므로
    // **병합 시 개방에서 반드시 제외**해야 한다(README "그룹 규칙 병합 시 주의").
    //
    // 그룹 이름·기간이 바뀌면 멤버 전원의 역인덱스를 갱신해야 하는데, 남의 문서에
    // 쓰기를 열 수는 없으므로 그 갱신은 서버 작업이 맡는다(DM-29 서버 작업).

    match /users/{userId}/groups/{groupId} {
      allow read: if isOwner(userId);

      // 역인덱스는 GRP-1 목록 행이 요구하는 값(여행지·멤버 수·배낭 연결 여부)을 전부 담는다 —
      // 목록을 그리려고 그룹 문서를 N번 읽지 않는 것이 이 컬렉션의 존재 이유다(DM-29).
      // `hasBag` 은 본인만 쓰는 값이라 클라이언트가 배낭 연결·해제 시 함께 갱신한다.
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name', 'startDate', 'endDate', 'role', 'joinedAt',
          'ownerId', 'memberCount', 'campSpotId', 'destinationName', 'hasBag'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'startDate', 'endDate', 'role', 'joinedAt',
          'ownerId', 'memberCount', 'hasBag'
        ])
        && isValidGroupName(request.resource.data.name)
        && isValidPeriod(request.resource.data.startDate, request.resource.data.endDate)
        && request.resource.data.role in ['owner', 'member']
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId.size() > 0
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount >= 1
        && request.resource.data.memberCount <= maxGroupMembers()
        && request.resource.data.hasBag is bool
        && (!('campSpotId' in request.resource.data)
          || (request.resource.data.campSpotId is string
            && request.resource.data.campSpotId.size() > 0))
        && (!('destinationName' in request.resource.data)
          || (request.resource.data.destinationName is string
            && request.resource.data.destinationName.size() <= 100));

      allow delete: if isOwner(userId);
    }
  }
}
