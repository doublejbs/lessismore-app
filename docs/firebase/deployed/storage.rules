rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /community/{userId}/{postId}/{imageId} {
      // 공개 게시글 사진은 읽기만 공개한다. list는 별도 match를 만들지 않아 허용하지 않는다.
      allow read: if imageId.matches('.*\\.jpg');
      allow write: if request.auth != null
        && request.auth.uid == userId
        && imageId.matches('.*\\.jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && imageId.matches('.*\\.jpg');
    }

    match /community/{allPaths=**} {
      allow list: if false;
    }
  
    // === 기존 규칙 유지(2026-09-03 병합) === community/ 경로는 위 전용 규칙만 적용된다.
    match /{allPaths=**} {
      allow read, write: if allPaths[0] != 'community';
    }
    match /{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
}
}
