rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPublishedPost(postId) {
      return get(/databases/$(database)/documents/community-posts/$(postId)).data.status == 'published';
    }

    function isOpenPoll(postId) {
      let post = get(/databases/$(database)/documents/community-posts/$(postId)).data;
      return !('expiresAt' in post.poll) || post.poll.expiresAt > request.time;
    }

    function samePostIdentity() {
      return request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.type == resource.data.type;
    }

    function unchangedCount(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function likeCounterMatches(postId) {
      let likePath = /databases/$(database)/documents/community-post-likes/$(request.auth.uid + '_' + postId);
      return request.resource.data.likeCount == resource.data.likeCount
        || (request.resource.data.likeCount == resource.data.likeCount + 1
          && existsAfter(likePath) && !exists(likePath))
        || (request.resource.data.likeCount == resource.data.likeCount - 1
          && !existsAfter(likePath) && exists(likePath));
    }

    function commentCounterMatches() {
      return request.resource.data.commentCount == resource.data.commentCount + 1
        || request.resource.data.commentCount == resource.data.commentCount - 1;
    }

    function sameExpiresAt() {
      return ('expiresAt' in resource.data.poll && 'expiresAt' in request.resource.data.poll
        && request.resource.data.poll.expiresAt == resource.data.poll.expiresAt)
        || (!('expiresAt' in resource.data.poll) && !('expiresAt' in request.resource.data.poll));
    }

    function pollIsOpen() {
      return !('expiresAt' in resource.data.poll)
        || resource.data.poll.expiresAt > request.time;
    }

    function sameAllowMultiple() {
      return (!('allowMultiple' in resource.data.poll)
          && !('allowMultiple' in request.resource.data.poll))
        || (('allowMultiple' in resource.data.poll)
          && ('allowMultiple' in request.resource.data.poll)
          && request.resource.data.poll.allowMultiple == resource.data.poll.allowMultiple);
    }

    function samePollOption(index) {
      return request.resource.data.poll.options[index].id == resource.data.poll.options[index].id
        && request.resource.data.poll.options[index].text == resource.data.poll.options[index].text
        && request.resource.data.poll.options[index].voteCount == resource.data.poll.options[index].voteCount;
    }

    function incrementedPollOption(index) {
      return request.resource.data.poll.options[index].id == resource.data.poll.options[index].id
        && request.resource.data.poll.options[index].text == resource.data.poll.options[index].text
        && request.resource.data.poll.options[index].voteCount == resource.data.poll.options[index].voteCount + 1;
    }

    function decrementedPollOption(index) {
      return request.resource.data.poll.options[index].id == resource.data.poll.options[index].id
        && request.resource.data.poll.options[index].text == resource.data.poll.options[index].text
        && request.resource.data.poll.options[index].voteCount == resource.data.poll.options[index].voteCount - 1;
    }

    function pollOptionsCounterMatches() {
      return request.resource.data.poll.options.size() == resource.data.poll.options.size()
        && (
          (resource.data.poll.options.size() == 2
            && ((incrementedPollOption(0) && samePollOption(1))
              || (samePollOption(0) && incrementedPollOption(1))))
          || (resource.data.poll.options.size() == 3
            && ((incrementedPollOption(0) && samePollOption(1) && samePollOption(2))
              || (samePollOption(0) && incrementedPollOption(1) && samePollOption(2))
              || (samePollOption(0) && samePollOption(1) && incrementedPollOption(2))))
          || (resource.data.poll.options.size() == 4
            && ((incrementedPollOption(0) && samePollOption(1) && samePollOption(2) && samePollOption(3))
              || (samePollOption(0) && incrementedPollOption(1) && samePollOption(2) && samePollOption(3))
              || (samePollOption(0) && samePollOption(1) && incrementedPollOption(2) && samePollOption(3))
              || (samePollOption(0) && samePollOption(1) && samePollOption(2) && incrementedPollOption(3))))
        );
    }

    function pollOptionExists(poll, optionId) {
      return (poll.options.size() == 2
        && (poll.options[0].id == optionId || poll.options[1].id == optionId))
        || (poll.options.size() == 3
          && (poll.options[0].id == optionId || poll.options[1].id == optionId
            || poll.options[2].id == optionId))
        || (poll.options.size() == 4
          && (poll.options[0].id == optionId || poll.options[1].id == optionId
            || poll.options[2].id == optionId || poll.options[3].id == optionId));
    }

    function voteOptionIdsValid(postId) {
      let ids = request.resource.data.optionIds;
      let poll = get(/databases/$(database)/documents/community-posts/$(postId)).data.poll;
      return ids.size() >= 1
        && ids.size() <= poll.options.size()
        && pollOptionExists(poll, ids[0])
        && (ids.size() == 1
          || (pollOptionExists(poll, ids[1]) && ids[1] != ids[0]))
        && (ids.size() <= 2
          || (pollOptionExists(poll, ids[2]) && ids[2] != ids[0] && ids[2] != ids[1]))
        && (ids.size() <= 3
          || (pollOptionExists(poll, ids[3]) && ids[3] != ids[0]
            && ids[3] != ids[1] && ids[3] != ids[2]));
    }

    function voteMoved(postId, previousOptionId, nextOptionId) {
      let votePath = /databases/$(database)/documents/community-poll-votes/$(postId + '_' + request.auth.uid);
      return exists(votePath)
        && existsAfter(votePath)
        && get(votePath).data.optionIds.size() == 1
        && getAfter(votePath).data.optionIds.size() == 1
        && get(votePath).data.optionIds[0] == previousOptionId
        && getAfter(votePath).data.optionIds[0] == nextOptionId;
    }

    function pollOptionsChangedCounterMatches(postId) {
      return request.resource.data.poll.options.size() == resource.data.poll.options.size()
        && (
          (resource.data.poll.options.size() == 2
            && ((decrementedPollOption(0) && incrementedPollOption(1)
                && voteMoved(postId, resource.data.poll.options[0].id, resource.data.poll.options[1].id))
              || (incrementedPollOption(0) && decrementedPollOption(1)
                && voteMoved(postId, resource.data.poll.options[1].id, resource.data.poll.options[0].id))))
          || (resource.data.poll.options.size() == 3
            && ((decrementedPollOption(0) && incrementedPollOption(1) && samePollOption(2)
                && voteMoved(postId, resource.data.poll.options[0].id, resource.data.poll.options[1].id))
              || (decrementedPollOption(0) && samePollOption(1) && incrementedPollOption(2)
                && voteMoved(postId, resource.data.poll.options[0].id, resource.data.poll.options[2].id))
              || (incrementedPollOption(0) && decrementedPollOption(1) && samePollOption(2)
                && voteMoved(postId, resource.data.poll.options[1].id, resource.data.poll.options[0].id))
              || (samePollOption(0) && decrementedPollOption(1) && incrementedPollOption(2)
                && voteMoved(postId, resource.data.poll.options[1].id, resource.data.poll.options[2].id))
              || (incrementedPollOption(0) && samePollOption(1) && decrementedPollOption(2)
                && voteMoved(postId, resource.data.poll.options[2].id, resource.data.poll.options[0].id))
              || (samePollOption(0) && incrementedPollOption(1) && decrementedPollOption(2)
                && voteMoved(postId, resource.data.poll.options[2].id, resource.data.poll.options[1].id))))
          || (resource.data.poll.options.size() == 4
            && ((decrementedPollOption(0) && incrementedPollOption(1) && samePollOption(2) && samePollOption(3)
                && voteMoved(postId, resource.data.poll.options[0].id, resource.data.poll.options[1].id))
              || (decrementedPollOption(0) && samePollOption(1) && incrementedPollOption(2) && samePollOption(3)
                && voteMoved(postId, resource.data.poll.options[0].id, resource.data.poll.options[2].id))
              || (decrementedPollOption(0) && samePollOption(1) && samePollOption(2) && incrementedPollOption(3)
                && voteMoved(postId, resource.data.poll.options[0].id, resource.data.poll.options[3].id))
              || (incrementedPollOption(0) && decrementedPollOption(1) && samePollOption(2) && samePollOption(3)
                && voteMoved(postId, resource.data.poll.options[1].id, resource.data.poll.options[0].id))
              || (samePollOption(0) && decrementedPollOption(1) && incrementedPollOption(2) && samePollOption(3)
                && voteMoved(postId, resource.data.poll.options[1].id, resource.data.poll.options[2].id))
              || (samePollOption(0) && decrementedPollOption(1) && samePollOption(2) && incrementedPollOption(3)
                && voteMoved(postId, resource.data.poll.options[1].id, resource.data.poll.options[3].id))
              || (incrementedPollOption(0) && samePollOption(1) && decrementedPollOption(2) && samePollOption(3)
                && voteMoved(postId, resource.data.poll.options[2].id, resource.data.poll.options[0].id))
              || (samePollOption(0) && incrementedPollOption(1) && decrementedPollOption(2) && samePollOption(3)
                && voteMoved(postId, resource.data.poll.options[2].id, resource.data.poll.options[1].id))
              || (samePollOption(0) && samePollOption(1) && decrementedPollOption(2) && incrementedPollOption(3)
                && voteMoved(postId, resource.data.poll.options[2].id, resource.data.poll.options[3].id))
              || (incrementedPollOption(0) && samePollOption(1) && samePollOption(2) && decrementedPollOption(3)
                && voteMoved(postId, resource.data.poll.options[3].id, resource.data.poll.options[0].id))
              || (samePollOption(0) && incrementedPollOption(1) && samePollOption(2) && decrementedPollOption(3)
                && voteMoved(postId, resource.data.poll.options[3].id, resource.data.poll.options[1].id))
              || (samePollOption(0) && samePollOption(1) && incrementedPollOption(2) && decrementedPollOption(3)
                && voteMoved(postId, resource.data.poll.options[3].id, resource.data.poll.options[2].id))))
        );
    }

    function pollOptionVotesAreZero(poll) {
      return (poll.options.size() == 2
        && poll.options[0].voteCount == 0
        && poll.options[1].voteCount == 0)
        || (poll.options.size() == 3
          && poll.options[0].voteCount == 0
          && poll.options[1].voteCount == 0
          && poll.options[2].voteCount == 0)
        || (poll.options.size() == 4
          && poll.options[0].voteCount == 0
          && poll.options[1].voteCount == 0
          && poll.options[2].voteCount == 0
          && poll.options[3].voteCount == 0);
    }

    function voteCreatedOptionMatches(postId) {
      let votePath = /databases/$(database)/documents/community-poll-votes/$(postId + '_' + request.auth.uid);
      let vote = getAfter(votePath).data;
      return vote.optionIds.size() == 1
        && ((request.resource.data.poll.options.size() == 2
          && ((incrementedPollOption(0) && vote.optionIds[0] == request.resource.data.poll.options[0].id)
            || (incrementedPollOption(1) && vote.optionIds[0] == request.resource.data.poll.options[1].id)))
          || (request.resource.data.poll.options.size() == 3
            && ((incrementedPollOption(0) && vote.optionIds[0] == request.resource.data.poll.options[0].id)
              || (incrementedPollOption(1) && vote.optionIds[0] == request.resource.data.poll.options[1].id)
              || (incrementedPollOption(2) && vote.optionIds[0] == request.resource.data.poll.options[2].id)))
          || (request.resource.data.poll.options.size() == 4
            && ((incrementedPollOption(0) && vote.optionIds[0] == request.resource.data.poll.options[0].id)
              || (incrementedPollOption(1) && vote.optionIds[0] == request.resource.data.poll.options[1].id)
              || (incrementedPollOption(2) && vote.optionIds[0] == request.resource.data.poll.options[2].id)
              || (incrementedPollOption(3) && vote.optionIds[0] == request.resource.data.poll.options[3].id))));
    }

    function multiVoteChanged(postId, optionId) {
      let votePath = /databases/$(database)/documents/community-poll-votes/$(postId + '_' + request.auth.uid);
      let before = get(votePath).data.optionIds;
      let after = getAfter(votePath).data.optionIds;
      return after.size() >= 1
        && ((after.size() == before.size() + 1
          && after.hasAll(before)
          && after.hasAny([optionId])
          && !before.hasAny([optionId]))
        || (before.size() == after.size() + 1
          && before.hasAll(after)
          && before.hasAny([optionId])
          && !after.hasAny([optionId])));
    }

    function multiPollOptionsChangedCounterMatches(postId) {
      return request.resource.data.poll.options.size() == resource.data.poll.options.size()
        && (resource.data.poll.options.size() == 2
          && ((decrementedPollOption(0) && samePollOption(1)
                && multiVoteChanged(postId, resource.data.poll.options[0].id))
              || (samePollOption(0) && decrementedPollOption(1)
                && multiVoteChanged(postId, resource.data.poll.options[1].id))
              || (incrementedPollOption(0) && samePollOption(1)
                && multiVoteChanged(postId, resource.data.poll.options[0].id))
              || (samePollOption(0) && incrementedPollOption(1)
                && multiVoteChanged(postId, resource.data.poll.options[1].id)))
          || (resource.data.poll.options.size() == 3
            && ((decrementedPollOption(0) && samePollOption(1) && samePollOption(2)
                  && multiVoteChanged(postId, resource.data.poll.options[0].id))
              || (samePollOption(0) && decrementedPollOption(1) && samePollOption(2)
                  && multiVoteChanged(postId, resource.data.poll.options[1].id))
              || (samePollOption(0) && samePollOption(1) && decrementedPollOption(2)
                  && multiVoteChanged(postId, resource.data.poll.options[2].id))
              || (incrementedPollOption(0) && samePollOption(1) && samePollOption(2)
                  && multiVoteChanged(postId, resource.data.poll.options[0].id))
              || (samePollOption(0) && incrementedPollOption(1) && samePollOption(2)
                  && multiVoteChanged(postId, resource.data.poll.options[1].id))
              || (samePollOption(0) && samePollOption(1) && incrementedPollOption(2)
                  && multiVoteChanged(postId, resource.data.poll.options[2].id))))
          || (resource.data.poll.options.size() == 4
            && ((decrementedPollOption(0) && samePollOption(1) && samePollOption(2) && samePollOption(3)
                  && multiVoteChanged(postId, resource.data.poll.options[0].id))
              || (samePollOption(0) && decrementedPollOption(1) && samePollOption(2) && samePollOption(3)
                  && multiVoteChanged(postId, resource.data.poll.options[1].id))
              || (samePollOption(0) && samePollOption(1) && decrementedPollOption(2) && samePollOption(3)
                  && multiVoteChanged(postId, resource.data.poll.options[2].id))
              || (samePollOption(0) && samePollOption(1) && samePollOption(2) && decrementedPollOption(3)
                  && multiVoteChanged(postId, resource.data.poll.options[3].id))
              || (incrementedPollOption(0) && samePollOption(1) && samePollOption(2) && samePollOption(3)
                  && multiVoteChanged(postId, resource.data.poll.options[0].id))
              || (samePollOption(0) && incrementedPollOption(1) && samePollOption(2) && samePollOption(3)
                  && multiVoteChanged(postId, resource.data.poll.options[1].id))
              || (samePollOption(0) && samePollOption(1) && incrementedPollOption(2) && samePollOption(3)
                  && multiVoteChanged(postId, resource.data.poll.options[2].id))
              || (samePollOption(0) && samePollOption(1) && samePollOption(2) && incrementedPollOption(3)
                  && multiVoteChanged(postId, resource.data.poll.options[3].id)))));
    }

    function authorPollIsUnvoted() {
      return (!('poll' in resource.data)
          || (resource.data.poll.totalVoteCount == 0
            && pollOptionVotesAreZero(resource.data.poll)))
        && (!('poll' in request.resource.data)
          || (request.resource.data.poll.totalVoteCount == 0
            && pollOptionVotesAreZero(request.resource.data.poll)));
    }

    function pollCounterMatches(postId) {
      let votePath = /databases/$(database)/documents/community-poll-votes/$(postId + '_' + request.auth.uid);
      return resource.data.hasPoll == true
        && (
          (request.resource.data.poll.totalVoteCount == resource.data.poll.totalVoteCount + 1
            && request.resource.data.poll.keys().hasOnly(['options', 'totalVoteCount', 'allowMultiple', 'expiresAt'])
            && resource.data.poll.keys().hasOnly(['options', 'totalVoteCount', 'allowMultiple', 'expiresAt'])
            && sameAllowMultiple()
            && sameExpiresAt()
            && pollIsOpen()
            && pollOptionsCounterMatches()
            && voteCreatedOptionMatches(postId)
            && existsAfter(votePath) && !exists(votePath))
          || (request.resource.data.poll.totalVoteCount == resource.data.poll.totalVoteCount
            && request.resource.data.poll.keys().hasOnly(['options', 'totalVoteCount', 'allowMultiple', 'expiresAt'])
            && resource.data.poll.keys().hasOnly(['options', 'totalVoteCount', 'allowMultiple', 'expiresAt'])
            && sameAllowMultiple()
            && sameExpiresAt()
            && pollIsOpen()
            && exists(votePath)
            && (pollOptionsChangedCounterMatches(postId)
              || (request.resource.data.poll.allowMultiple == true
                && multiPollOptionsChangedCounterMatches(postId))))
        );
    }

    match /community-posts/{postId} {
      allow read: if resource.data.status == 'published';
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'type', 'status', 'authorId', 'authorName', 'title', 'body',
          'images', 'bagSnapshot', 'poll', 'hasBagSnapshot', 'hasPoll',
          'likeCount', 'commentCount',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'published'
        && request.resource.data.type == 'post'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname
        && request.resource.data.hasBagSnapshot == ('bagSnapshot' in request.resource.data)
        && request.resource.data.hasPoll == ('poll' in request.resource.data)
        && (!request.resource.data.hasPoll
          || (request.resource.data.poll.totalVoteCount == 0
            && request.resource.data.poll.keys().hasOnly([
              'options', 'totalVoteCount', 'allowMultiple', 'expiresAt'
            ])
            && request.resource.data.poll.allowMultiple is bool
            && pollOptionVotesAreZero(request.resource.data.poll)));
      // 작성자는 내용·사진·스냅샷만 수정할 수 있다. hidden은 운영자 규칙을 별도로 둔다.
      // 좋아요·댓글·투표 트랜잭션의 카운트는 정확히 ±1만 허용해야 한다.
      // Firestore Rules만으로 대응 문서 쓰기와 같은 트랜잭션인지 완전히 검증할 수 없으므로,
      // 실제 배포 전 운영자/서버 검증 방식과 함께 검토한다.
      // hiddenCleanedAt, deletedCleanedAt, hiddenCountAdjustedAt, withdrawalProcessedAt는
      // 탈퇴·삭제 연쇄 정리를 담당하는 서버 Functions 전용 필드이며 클라이언트 쓰기를 허용하지 않는다.
      allow update: if signedIn() && samePostIdentity()
        && (
          (resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'title', 'body', 'images', 'bagSnapshot', 'poll',
              'hasBagSnapshot', 'hasPoll',
              'updatedAt'
            ])
            && (
              request.resource.data.status == resource.data.status
              || (resource.data.status == 'published'
                && request.resource.data.status == 'deleted')
            )
            && unchangedCount('likeCount')
            && unchangedCount('commentCount')
            && request.resource.data.hasBagSnapshot == ('bagSnapshot' in request.resource.data)
            && request.resource.data.hasPoll == ('poll' in request.resource.data)
            && (!request.resource.data.hasPoll
              || request.resource.data.poll.allowMultiple is bool)
            && (!request.resource.data.hasPoll
              || request.resource.data.poll.keys().hasOnly([
                'options', 'totalVoteCount', 'allowMultiple', 'expiresAt'
              ]))
            && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['poll', 'hasPoll'])
              ? authorPollIsUnvoted()
              : true)
            && (request.resource.data.status != 'deleted'
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'authorName', 'title', 'body', 'images', 'bagSnapshot', 'poll'
              ])))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'likeCount'
            ])
            && likeCounterMatches(postId))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'commentCount'
            ])
            && commentCounterMatches())
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'poll'
            ])
            && pollCounterMatches(postId))
        );
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if isPublishedPost(postId)
          && resource.data.status in ['published', 'deleted'];
        allow create: if isPublishedPost(postId)
          && signedIn()
          && request.resource.data.keys().hasOnly([
            'status', 'authorId', 'authorName', 'body', 'parentId',
            'mentionedUserId', 'mentionedUserName', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.status == 'published'
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname;
        allow update: if signedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'authorName', 'body', 'deletedReason', 'updatedAt'
          ])
          && (
            (request.resource.data.status == resource.data.status
              && request.resource.data.authorId == resource.data.authorId
              && request.resource.data.status == 'published')
            ||
            (request.resource.data.status == 'deleted'
              && request.resource.data.authorName == ''
              && request.resource.data.body == ''
              && request.resource.data.deletedReason == 'author'
              && request.resource.data.authorId == resource.data.authorId)
          );
        allow delete: if false;
      }
    }

    match /community-post-likes/{likeId} {
      allow read: if signedIn() && likeId.matches('^' + request.auth.uid + '_.*');
      allow create: if signedIn()
        && likeId.matches('^' + request.auth.uid + '_.*')
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /community-poll-votes/{voteId} {
      allow read: if signedIn() && voteId.matches('^.*_' + request.auth.uid + '$');
      allow create: if signedIn()
        && voteId.matches('^.*_' + request.auth.uid + '$')
        && request.resource.data.keys().hasOnly([
          'postId', 'userId', 'optionIds', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.optionIds.size() == 1
        && voteOptionIdsValid(request.resource.data.postId)
        && isOpenPoll(request.resource.data.postId)
        && isPublishedPost(request.resource.data.postId);
      allow update: if signedIn()
        && voteId.matches('^.*_' + request.auth.uid + '$')
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.keys().hasOnly([
          'postId', 'userId', 'optionIds', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['optionIds', 'updatedAt'])
        && voteOptionIdsValid(request.resource.data.postId)
        && (get(/databases/$(database)/documents/community-posts/$(request.resource.data.postId)).data.poll.allowMultiple == true
          || request.resource.data.optionIds.size() == 1)
        && isOpenPoll(request.resource.data.postId)
        && isPublishedPost(request.resource.data.postId);
      allow delete: if false;
    }

    match /community-reports/{reportId} {
      allow create: if signedIn()
        && reportId.matches('^' + request.auth.uid + '_.*')
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if signedIn() && reportId.matches('^' + request.auth.uid + '_.*');
      allow update, delete: if false;
    }

    // 운영자는 위 콘텐츠 규칙을 별도 관리자 UID/커스텀 클레임 규칙으로 확장한다.
    // 일반 클라이언트가 전체 신고 목록이나 상태를 읽고 바꾸는 것은 금지한다.

    // ====================================================================
    // 그룹(DM-29, Group.md GRP-1~12) — docs/firebase/group-firestore.rules 병합.
    // 원본 파일이 계약의 정본이고 이 절은 그 사본이다. 한쪽만 고치지 않는다.
    // 공통 헬퍼 signedIn()·isOwner() 는 커뮤니티 절의 것과 정의가 같아 재사용한다.
    // ====================================================================

    // --- 공통 헬퍼 -------------------------------------------------------

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // GRP-2 / GRP-3 / GRP-8 / GRP-9 의 상한을 한곳에서 관리한다.
    function maxGroupMembers() {
      return 20;
    }

    function maxGroupPoints() {
      return 50;
    }

    function maxGroupRoutes() {
      return 5;
    }

    function maxRouteFileSize() {
      return 5 * 1024 * 1024;
    }

    // --- 그룹 문서 접근 헬퍼 ----------------------------------------------

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    // 커밋 **전** 상태. 읽기·수정·삭제 판정에 쓴다.
    function groupBefore(groupId) {
      return get(groupPath(groupId)).data;
    }

    // 커밋 **후** 상태. 그룹 생성 배치(그룹 문서 + 방장 멤버 문서)나 참여 배치처럼
    // 같은 커밋에서 memberIds가 바뀌는 경우에 쓴다. get()은 커밋 전 상태만 보므로
    // 생성 시점에는 그룹 문서가 아직 없어 판정이 불가능하다.
    function groupAfter(groupId) {
      return getAfter(groupPath(groupId)).data;
    }

    function isGroupMember(groupId) {
      return signedIn() && request.auth.uid in groupBefore(groupId).memberIds;
    }

    function willBeGroupMember(groupId) {
      return signedIn() && request.auth.uid in groupAfter(groupId).memberIds;
    }

    function isGroupOwner(groupId) {
      return signedIn() && groupBefore(groupId).ownerId == request.auth.uid;
    }

    // --- 값 검증 헬퍼 -----------------------------------------------------

    function isIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // `YYYY-MM-DD` 는 사전순 비교가 곧 날짜순 비교다(고정 폭 + 0 패딩).
    // 규칙 언어에는 날짜 산술이 없어 GRP-2 의 "최대 30일"은 강제하지 못한다(클라이언트 검증).
    function isValidPeriod(startDate, endDate) {
      return isIsoDate(startDate) && isIsoDate(endDate) && startDate <= endDate;
    }

    // trim 은 규칙에서 할 수 없다. 길이 상한만 막고 공백 정규화는 클라이언트 몫이다(GRP-2).
    function isValidGroupName(value) {
      return value is string && value.size() >= 2 && value.size() <= 40;
    }

    function isValidLatitude(value) {
      return value is number && value >= -90 && value <= 90;
    }

    function isValidLongitude(value) {
      return value is number && value >= -180 && value <= 180;
    }

    function unchangedField(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function changedByOne(field) {
      return request.resource.data[field] == resource.data[field] + 1
        || request.resource.data[field] == resource.data[field] - 1;
    }

    // --- groups/{groupId} -------------------------------------------------

    // 서버 전용 필드 `deletedCleanedAt`(해산 연쇄 정리 멱등 가드)은 아래 어떤
    // 허용 키 목록에도 들어 있지 않다. 따라서 클라이언트는 생성·수정 어느 경로로도 쓸 수 없다.
    function groupWritableKeys() {
      return [
        'name', 'startDate', 'endDate', 'ownerId', 'memberIds', 'memberCount',
        'campSpotId', 'destinationName', 'meetingNote', 'inviteEnabled',
        'pointCount', 'routeCount', 'createdAt', 'updatedAt'
      ];
    }

    function isValidGroupPayload() {
      let data = request.resource.data;

      return isValidGroupName(data.name)
        && isValidPeriod(data.startDate, data.endDate)
        && data.inviteEnabled is bool
        && (!('campSpotId' in data)
          || (data.campSpotId is string && data.campSpotId.size() > 0))
        && (!('destinationName' in data)
          || (data.destinationName is string && data.destinationName.size() <= 100))
        && (!('meetingNote' in data)
          || (data.meetingNote is string && data.meetingNote.size() <= 200));
    }

    // 방장 편집(GRP-4). ownerId·memberIds·memberCount·pointCount·routeCount 는
    // 허용 키 목록에 없으므로 이 경로로는 바뀌지 않는다.
    function isGroupOwnerEdit() {
      return resource.data.ownerId == request.auth.uid
        && changedKeys().hasOnly([
          'name', 'startDate', 'endDate', 'campSpotId', 'destinationName',
          'meetingNote', 'inviteEnabled', 'updatedAt'
        ])
        && isValidGroupPayload();
    }

    // 참여(GRP-3). memberIds 에 **자기 uid 하나만** 늘어난 update 로 처리한다.
    //
    // 규칙 언어에는 배열 diff 연산이 없어 `size() + hasAll + in` 조합으로 좁힌다.
    //   - after.size() == before.size() + 1  → 정확히 하나 늘었다
    //   - after.hasAll(before)               → 기존 원소가 하나도 빠지지 않았다
    //   - uid in after && !(uid in before)   → 늘어난 그 하나가 요청자 자신이다
    // 이 조합은 memberIds 에 중복 원소가 없다는 전제에서 완전하다. 중복은 생성 규칙
    // (`memberIds == [uid]`)과 참여·탈퇴 규칙이 귀납적으로 막는다(참여는 이미 있는 uid 를
    // 다시 넣지 못하고, 탈퇴는 원소를 뺄 뿐이다).
    function isGroupJoin() {
      let before = resource.data.memberIds;
      let after = request.resource.data.memberIds;

      return resource.data.inviteEnabled == true
        && changedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt'])
        && after.size() == before.size() + 1
        && after.size() <= maxGroupMembers()
        && after.hasAll(before)
        && !(request.auth.uid in before)
        && request.auth.uid in after
        && request.resource.data.memberCount == after.size();
    }

    // 탈퇴(본인) · 내보내기(방장) (GRP-4, GRP-12).
    //   - before.hasAll(after) + size-1 → 정확히 하나 빠졌다
    //   - 방장은 배열에서 빠질 수 없다 → 방장이 나가려면 해산(delete)을 거쳐야 한다
    //   - 본인 탈퇴: 빠진 그 하나가 요청자다
    //   - 내보내기: 요청자가 방장이고 스스로는 남아 있다(빠진 대상은 방장이 아닌 멤버 하나)
    function isGroupLeaveOrKick() {
      let before = resource.data.memberIds;
      let after = request.resource.data.memberIds;

      return changedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt'])
        && after.size() == before.size() - 1
        && before.hasAll(after)
        && request.resource.data.memberCount == after.size()
        && resource.data.ownerId in after
        && (
          (request.auth.uid in before && !(request.auth.uid in after))
          || (resource.data.ownerId == request.auth.uid && request.auth.uid in after)
        );
    }

    // 하위 문서 카운터(GRP-8, GRP-9). 포인트·코스 생성/삭제 배치가 같은 커밋에서
    // 이 경로로 카운터를 ±1 한다. 임의값 세팅은 불가능하고, 상한을 여기서 막는다.
    //
    // 남는 구멍: 포인트를 만들지 않고 카운터만 올려 그룹의 포인트 예산을 소진하는
    // 멤버 griefing 은 막지 못한다. 포인트·코스 문서 ID가 랜덤이라 커뮤니티 좋아요처럼
    // 결정적 ID로 `existsAfter()` 대조를 할 수 없기 때문이다. 그룹은 초대로만 들어오는
    // 20인 이하 집단이고 피해가 그 그룹 안에 갇히므로 수용한다(2026-09-17 결정).
    function isGroupCounterUpdate() {
      return request.auth.uid in resource.data.memberIds
        && changedKeys().hasOnly(['pointCount', 'routeCount', 'updatedAt'])
        && (
          (changedByOne('pointCount') && unchangedField('routeCount'))
          || (changedByOne('routeCount') && unchangedField('pointCount'))
        )
        && request.resource.data.pointCount >= 0
        && request.resource.data.pointCount <= maxGroupPoints()
        && request.resource.data.routeCount >= 0
        && request.resource.data.routeCount <= maxGroupRoutes();
    }

    match /groups/{groupId} {
      // `groupId` 자체가 초대 비밀이다(GRP-3). Firestore 자동 생성 20자 ID는 추측할 수
      // 없고, 배낭 링크 공유와 같은 보안 수준이다. 초대 화면에서 비멤버가 이름·기간·정원·
      // inviteEnabled 를 봐야 하므로 인증 사용자면 단건 읽기를 허용한다.
      allow get: if signedIn();

      // 목록 조회는 금지한다. 전체 그룹 열거를 막고, 내 그룹 목록은
      // users/{uid}/groups 역인덱스로만 읽는다(DM-29).
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(groupWritableKeys())
        && request.resource.data.keys().hasAll([
          'name', 'startDate', 'endDate', 'ownerId', 'memberIds', 'memberCount',
          'inviteEnabled', 'pointCount', 'routeCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberCount == 1
        && request.resource.data.pointCount == 0
        && request.resource.data.routeCount == 0
        && isValidGroupPayload();

      // 네 경로만 허용한다: 방장 편집 · 참여 · 탈퇴/내보내기 · 하위 문서 카운터.
      // 어느 경로도 ownerId 를 바꾸지 않는다(방장 위임 없음, GRP-4).
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(groupWritableKeys())
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          isGroupOwnerEdit()
          || isGroupJoin()
          || isGroupLeaveOrKick()
          || isGroupCounterUpdate()
        );

      // 해산은 방장만(GRP-4). 하위 컬렉션·Storage GPX 연쇄 정리는 재시도 가능한
      // 서버 작업이 맡는다(GRP-12, DM-29 서버 작업).
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // --- groups/{groupId}/members/{memberId} ---------------------------

      match /members/{memberId} {
        allow read: if isGroupMember(groupId);

        // 그룹 생성 배치(그룹 문서 + 방장 멤버 문서)와 참여 배치 모두 같은 커밋에서
        // memberIds 가 정해지므로 커밋 **후** 상태로 판정한다.
        allow create: if isOwner(memberId)
          && willBeGroupMember(groupId)
          && request.resource.data.keys().hasOnly([
            'uid', 'nickname', 'role', 'bagId', 'joinedAt'
          ])
          && request.resource.data.keys().hasAll(['uid', 'nickname', 'role', 'joinedAt'])
          && request.resource.data.uid == memberId
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 40
          // role 은 그룹 문서의 ownerId 와 반드시 일치한다. 방장이 아닌 사람이
          // owner 로 들어오거나, 방장이 member 로 들어오는 것을 막는다.
          && request.resource.data.role ==
            (groupAfter(groupId).ownerId == memberId ? 'owner' : 'member')
          && (!('bagId' in request.resource.data)
            || (request.resource.data.bagId is string
              && request.resource.data.bagId.size() > 0));

        // 본인 문서만 수정한다(배낭 연결·해제, 닉네임 갱신). `role` 은 생성 시에만
        // 정해지고 이후 불변이다 — 허용 키 목록에 없다(방장 위임 없음, GRP-4).
        allow update: if isOwner(memberId)
          && isGroupMember(groupId)
          && changedKeys().hasOnly(['nickname', 'bagId'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 40
          && (!('bagId' in request.resource.data)
            || (request.resource.data.bagId is string
              && request.resource.data.bagId.size() > 0));

        // 본인 탈퇴 또는 방장의 내보내기(GRP-4, GRP-12).
        // 탈퇴 배치는 groups.memberIds 도 같이 바꾸므로 커밋 전 상태로 판정한다.
        allow delete: if isOwner(memberId) || isGroupOwner(groupId);
      }

      // --- groups/{groupId}/bags/{memberId} ------------------------------
      //
      // 멤버 배낭 공개 스냅샷(GRP-5, DM-29 = DM-28 bagSnapshot 과 같은 계약).
      //
      // **이 허용 키 목록이 개인정보 계약의 마지막 방어선이다.** `bag` 문서에는 메모·
      // 좌표·건강 기록이 함께 들어 있어 그룹원에게 읽기를 열면 그것까지 열린다. 스냅샷을
      // 그룹 하위에 따로 두고 규칙으로 키를 못박아 공개 범위를 **데이터 모양으로 고정**한다.
      //
      // 담지 않는 것: 메모, 정확한 좌표, 이동 경로, 건강·활동 기록(DM-22),
      // 개인 장비 imageUrl, 사용자 정의 장비 문서 ID.

      match /bags/{memberId} {
        function isValidBagSnapshot() {
          let data = request.resource.data;

          return data.keys().hasOnly([
              'bagId', 'name', 'startDate', 'endDate', 'destinationName',
              'totalWeight', 'itemCount', 'gears', 'syncedAt'
            ])
            && data.keys().hasAll([
              'bagId', 'name', 'totalWeight', 'itemCount', 'gears', 'syncedAt'
            ])
            && data.bagId is string && data.bagId.size() > 0
            && data.name is string && data.name.size() <= 100
            && (!('startDate' in data) || isIsoDate(data.startDate))
            && (!('endDate' in data) || isIsoDate(data.endDate))
            && (!('destinationName' in data)
              || (data.destinationName is string && data.destinationName.size() <= 100))
            && data.totalWeight is number && data.totalWeight >= 0
            && data.itemCount is int && data.itemCount >= 0
            && data.gears is list && data.gears.size() <= 300
            && data.syncedAt is timestamp;
        }

        allow read: if isGroupMember(groupId);

        // 문서 ID == 자기 uid. 멤버당 하나로 구조적으로 고정된다.
        allow create, update: if isOwner(memberId)
          && isGroupMember(groupId)
          && isValidBagSnapshot();

        // 연결 해제(본인) 또는 내보내기·해산 정리(방장).
        allow delete: if isOwner(memberId) || isGroupOwner(groupId);
      }

      // --- groups/{groupId}/points/{pointId} -----------------------------

      match /points/{pointId} {
        function isValidPointPayload() {
          let data = request.resource.data;

          return data.type in ['water', 'shelter', 'caution', 'note']
            && isValidLatitude(data.latitude)
            && isValidLongitude(data.longitude)
            && data.title is string
            && data.title.size() >= 1
            && data.title.size() <= 40
            && (!('description' in data)
              || (data.description is string && data.description.size() <= 200));
        }

        // 그룹당 50개 상한(GRP-9)은 컬렉션 문서 수를 셀 수 없어 규칙만으로는 막지 못한다.
        // 대신 생성·삭제를 groups.pointCount ±1 과 **같은 커밋**으로 묶어 상한을 강제한다.
        // 클라이언트 계약: createPoint/deletePoint 는 writeBatch 로 문서와 카운터를 함께 쓴다.
        function pointCounterIncremented() {
          return groupAfter(groupId).pointCount == groupBefore(groupId).pointCount + 1;
        }

        function pointCounterDecremented() {
          return groupAfter(groupId).pointCount == groupBefore(groupId).pointCount - 1;
        }

        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.keys().hasOnly([
            'type', 'latitude', 'longitude', 'title', 'description',
            'authorId', 'authorName', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'type', 'latitude', 'longitude', 'title', 'authorId', 'authorName', 'createdAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 40
          && isValidPointPayload()
          && pointCounterIncremented();

        // 올린 사람과 방장만 수정한다(GRP-4, GRP-9). authorId·authorName 은 불변이다 —
        // 나간 멤버 표시(`(나간 멤버)`) 치환은 서버 작업이 맡는다(GRP-12).
        allow update: if isGroupMember(groupId)
          && (resource.data.authorId == request.auth.uid || isGroupOwner(groupId))
          && changedKeys().hasOnly([
            'type', 'latitude', 'longitude', 'title', 'description', 'updatedAt'
          ])
          && request.resource.data.authorId == resource.data.authorId
          && isValidPointPayload();

        allow delete: if isGroupMember(groupId)
          && (resource.data.authorId == request.auth.uid || isGroupOwner(groupId))
          && pointCounterDecremented();
      }

      // --- groups/{groupId}/routes/{routeId} -----------------------------

      match /routes/{routeId} {
        function isValidRoutePayload() {
          let data = request.resource.data;

          return data.name is string
            && data.name.size() >= 1
            && data.name.size() <= 40
            // 원본 GPX 는 Storage 에만 둔다. 경로를 문서 ID에 못박아 남의 파일을 가리키지 못하게 한다.
            && data.storagePath == 'groups/' + groupId + '/routes/' + routeId + '.gpx'
            && data.fileSize is int
            && data.fileSize > 0
            && data.fileSize <= maxRouteFileSize()
            && data.distance is number
            && data.distance >= 0
            && (!('elevationGain' in data)
              || (data.elevationGain is number && data.elevationGain >= 0))
            && data.pointCount is int
            && data.pointCount >= 0
            && data.bounds is map
            && data.bounds.keys().hasOnly(['minLat', 'maxLat', 'minLng', 'maxLng'])
            && data.bounds.keys().hasAll(['minLat', 'maxLat', 'minLng', 'maxLng'])
            && isValidLatitude(data.bounds.minLat)
            && isValidLatitude(data.bounds.maxLat)
            && isValidLongitude(data.bounds.minLng)
            && isValidLongitude(data.bounds.maxLng)
            // 축약 좌표 500점 상한(GRP-8). 원본 트랙포인트 전체는 Firestore 에 넣지 않는다 —
            // 1MB 문서 한도와 렌더 성능 때문이다.
            && data.simplified is list
            && data.simplified.size() >= 2
            && data.simplified.size() <= 500;
        }

        // 그룹당 5개 상한(GRP-8). 포인트와 같은 배치 결합으로 강제한다.
        function routeCounterIncremented() {
          return groupAfter(groupId).routeCount == groupBefore(groupId).routeCount + 1;
        }

        function routeCounterDecremented() {
          return groupAfter(groupId).routeCount == groupBefore(groupId).routeCount - 1;
        }

        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.keys().hasOnly([
            'name', 'storagePath', 'fileSize', 'distance', 'elevationGain',
            'pointCount', 'bounds', 'simplified', 'authorId', 'authorName', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'name', 'storagePath', 'fileSize', 'distance', 'pointCount',
            'bounds', 'simplified', 'authorId', 'authorName', 'createdAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 40
          && isValidRoutePayload()
          && routeCounterIncremented();

        // 코스는 이름 변경이 필요 없으므로 수정 경로를 두지 않는다(GRP-8).
        allow update: if false;

        allow delete: if isGroupMember(groupId)
          && (resource.data.authorId == request.auth.uid || isGroupOwner(groupId))
          && routeCounterDecremented();
      }
    }

    // --- users/{userId}/groups/{groupId} 역인덱스 --------------------------
    //
    // 내가 속한 그룹 목록(DM-29). 이 경로는 현재 배포본의 전면 개방 절에 걸려 있으므로
    // **병합 시 개방에서 반드시 제외**해야 한다(README "그룹 규칙 병합 시 주의").
    //
    // 그룹 이름·기간이 바뀌면 멤버 전원의 역인덱스를 갱신해야 하는데, 남의 문서에
    // 쓰기를 열 수는 없으므로 그 갱신은 서버 작업이 맡는다(DM-29 서버 작업).

    match /users/{userId}/groups/{groupId} {
      allow read: if isOwner(userId);

      // 역인덱스는 GRP-1 목록 행이 요구하는 값(여행지·멤버 수·배낭 연결 여부)을 전부 담는다 —
      // 목록을 그리려고 그룹 문서를 N번 읽지 않는 것이 이 컬렉션의 존재 이유다(DM-29).
      // `hasBag`·`bagId` 는 본인만 쓰는 값이라 클라이언트가 배낭 연결·해제 시 함께 갱신한다.
      // `bagId` 를 여기 두는 이유: 배낭이 바뀌었을 때 어느 그룹 스냅샷을 다시 써야 하는지를
      // 그룹마다 members/{uid} 를 읽지 않고 알기 위해서다(GRP-5 갱신 시점 ①②).
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name', 'startDate', 'endDate', 'role', 'joinedAt',
          'ownerId', 'memberCount', 'campSpotId', 'destinationName', 'hasBag', 'bagId'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'startDate', 'endDate', 'role', 'joinedAt',
          'ownerId', 'memberCount', 'hasBag'
        ])
        && isValidGroupName(request.resource.data.name)
        && isValidPeriod(request.resource.data.startDate, request.resource.data.endDate)
        && request.resource.data.role in ['owner', 'member']
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId.size() > 0
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount >= 1
        && request.resource.data.memberCount <= maxGroupMembers()
        && request.resource.data.hasBag is bool
        && (!('campSpotId' in request.resource.data)
          || (request.resource.data.campSpotId is string
            && request.resource.data.campSpotId.size() > 0))
        && (!('destinationName' in request.resource.data)
          || (request.resource.data.destinationName is string
            && request.resource.data.destinationName.size() <= 100))
        && (!('bagId' in request.resource.data)
          || (request.resource.data.bagId is string
            && request.resource.data.bagId.size() > 0))
        && (request.resource.data.hasBag == ('bagId' in request.resource.data));

      allow delete: if isOwner(userId);
    }

    // ------------------------------------------------------------------
    // groupInvites/{groupId} — 초대 공개 요약 (DM-29)
    //
    // 초대 링크를 연 웹 랜딩이 읽는 유일한 공개 문서다. 그룹 문서는 signedIn()을
    // 요구하는데 웹 랜딩은 비인증이라, 초대 화면에 필요한 값만 서버가 복제해 둔다.
    // 담기는 것: name / startDate / endDate / destinationName? / memberCount /
    // inviteEnabled / updatedAt. 집합 메모와 멤버 uid는 복제하지 않는다 —
    // 링크는 전달될 수 있고 집합 메모는 일행의 실제 집합 시각·장소다.
    //
    // 쓰기는 전면 금지다. groups/{groupId} 쓰기 트리거(admin SDK)만 이 문서를
    // 만들고 갱신하고 지운다. 클라이언트 쓰기를 열면 잠금·정원 표시를 위조할 수
    // 있고, 무엇보다 미러가 원본과 갈라진다.
    // ------------------------------------------------------------------

    match /groupInvites/{groupId} {
      // groupId 자체가 초대 비밀이라는 전제는 그룹 문서와 같다.
      // list는 막는다 — 전체 열거를 허용하면 초대 비밀 전제가 무너진다.
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }


    // ====================================================================
    // 배낭 코스(GPX) — docs/firebase/bag-firestore.rules 병합 (DM-30, BD-11).
    // 원본 파일이 계약의 정본이고 이 절은 그 사본이다. 한쪽만 고치지 않는다.
    //
    // `bag/{bagId}` 문서는 `shared == true` 면 링크만 있으면 비로그인 누구나 읽는 공개
    // 문서다(BD-7). 그런데 GPX 는 그 사람이 언제 어디를 지날지를 미터 단위로 담는다.
    // 그래서 하위 `routes` 는 **소유자(`bag.userId`)만** 읽고 쓴다 — 배낭 공유·박지 후기
    // 첨부·커뮤니티 패킹 스냅샷 어디로도 따라가지 않는다(DM-30).
    //
    // 아래 개방 절(`isLockedCollection`)에서 `bag` 을 뺀 뒤 배낭 문서와 나머지 하위를
    // 다시 열어 두었다. 빼지 않으면 match 가 OR 로 합쳐져 이 절이 아무 효력이 없다.
    // 값 검증 헬퍼(isValidLatitude·isValidLongitude·maxRouteFileSize)는 그룹 절의 것을
    // 그대로 쓴다 — 같은 값을 두 벌로 두지 않는다(중복 정의는 컴파일 에러이기도 하다).
    // ====================================================================

    match /bag/{bagId}/routes/{routeId} {
      // 소유자 판정 소스는 `bag.userId` **하나**다. Storage 규칙도 같은 값을 교차 조회한다.
      function isBagOwner() {
        return signedIn()
          && request.auth.uid ==
            get(/databases/$(database)/documents/bag/$(bagId)).data.userId;
      }

      // 그룹 코스의 isValidRoutePayload 와 **같은 조건**이다(DM-30: 수치를 갈라 두지 않는다).
      // 다른 점은 `authorId`·`authorName` 이 없다는 것뿐이다 — 배낭 코스는 소유자 한 사람의
      // 것이라 작성자를 적을 이유가 없고, 키 목록으로 그것을 못박는다.
      function isValidBagRoutePayload() {
        let data = request.resource.data;

        return data.keys().hasOnly([
            'name', 'storagePath', 'fileSize', 'distance', 'elevationGain',
            'pointCount', 'bounds', 'simplified', 'createdAt'
          ])
          && data.keys().hasAll([
            'name', 'storagePath', 'fileSize', 'distance',
            'pointCount', 'bounds', 'simplified', 'createdAt'
          ])
          && data.name is string
          && data.name.size() >= 1
          && data.name.size() <= 40
          // 원본 GPX 는 Storage 에만 둔다. 경로를 문서 ID에 못박아 남의 파일을 가리키지 못하게 한다.
          && data.storagePath == 'bags/' + bagId + '/routes/' + routeId + '.gpx'
          && data.fileSize is int
          && data.fileSize > 0
          && data.fileSize <= maxRouteFileSize()
          && data.distance is number
          && data.distance >= 0
          && (!('elevationGain' in data)
            || (data.elevationGain is number && data.elevationGain >= 0))
          && data.pointCount is int
          && data.pointCount >= 0
          && data.bounds is map
          && data.bounds.keys().hasOnly(['minLat', 'maxLat', 'minLng', 'maxLng'])
          && data.bounds.keys().hasAll(['minLat', 'maxLat', 'minLng', 'maxLng'])
          && isValidLatitude(data.bounds.minLat)
          && isValidLatitude(data.bounds.maxLat)
          && isValidLongitude(data.bounds.minLng)
          && isValidLongitude(data.bounds.maxLng)
          // 축약 좌표 500점 상한. 원본 트랙포인트 전체는 Firestore 에 넣지 않는다.
          && data.simplified is list
          && data.simplified.size() >= 2
          && data.simplified.size() <= 500;
      }

      // 소유자만 읽는다. 목록(list)도 같은 조건이다 — 화면이 코스 목록을 조회해 그린다.
      // **`shared == true` 여부를 보지 않는다**: 공유된 배낭이라도 코스는 따라가지 않는다.
      allow read: if isBagOwner();

      allow create: if isBagOwner() && isValidBagRoutePayload();

      // 코스는 이름 변경이 필요 없으므로 수정 경로를 두지 않는다(그룹 코스와 같다).
      allow update: if false;

      allow delete: if isBagOwner();
    }

    // === 기존 규칙 유지(2026-09-03 병합, 2026-09-17 그룹 추가) ===
    // 프로덕션에 있던 전면 개방 규칙을 그대로 두되, 전용 규칙을 둔 컬렉션만 제외해
    // 위 전용 규칙이 유일한 판정이 되게 한다. Firestore 의 match 는 OR 로 합쳐지므로
    // 개방 절에 남아 있으면 전용 규칙이 아무 효력이 없다.
    // TODO(보안): 나머지 컬렉션도 별도 작업으로 좁혀야 한다.
    //
    // `users` 와 `bag` 은 통째로 뺀 뒤 아래에서 하위를 갈라 연다 — users/{uid}/groups 역인덱스와
    // bag/{bagId}/routes 가 중첩 경로라 request.path[3](최상위 컬렉션명)만으로는 걸러지지 않기
    // 때문이다.
    // **request.path.size() 를 쓰면 안 된다** — 규칙 언어에 없는 함수라
    // `Function not found error: Name: [size]` 로 평가 전체가 에러가 되고
    // users/* 전 경로가 거부되는 회귀가 난다(2026-09-17 에뮬레이터 확인).
    function isLockedCollection() {
      return request.path[3] in [
        'community-posts', 'community-post-likes', 'community-poll-votes',
        'community-reports', 'groups', 'groupInvites', 'users', 'bag'
      ];
    }

    // users 문서 자체는 기존대로 열어 둔다.
    match /users/{userId} {
      allow read, write: if true;
    }

    // users 하위는 groups 만 빼고 기존대로 열어 둔다(users/{uid}/gears 등).
    match /users/{userId}/{subCollection}/{restOfPath=**} {
      allow read, write: if subCollection != 'groups';
    }

    // 배낭 문서 자체는 기존대로 열어 둔다 — `shared == true` 링크 공유가 이 개방에 얹혀 있다(BD-7).
    match /bag/{bagId} {
      allow read, write: if true;
    }

    // 배낭 하위는 routes 만 빼고 기존대로 열어 둔다. 지금 다른 하위 컬렉션은 없지만,
    // 개방 절에서 bag 을 통째로 뺀 이상 이 절이 없으면 나중에 생기는 하위 컬렉션이
    // 소리 없이 전부 거부된다.
    match /bag/{bagId}/{subCollection}/{restOfPath=**} {
      allow read, write: if subCollection != 'routes';
    }

    match /{document=**} {
      allow read, write: if !isLockedCollection();
    }
}
}
